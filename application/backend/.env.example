# Application
APP_NAME=Stylic AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
MONGO_URL=mongodb+srv://infostylicai:gUgH6G9oDimFRWIS@stylicai.tio3ghn.mongodb.net/
MONGO_DB_NAME=stylic
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1

# Email Configuration
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=info@stylic.ai
SMTP_PASSWORD=Har@#0401
EMAIL_FROM=info@stylic.ai
EMAIL_FROM_NAME=Stylic AI

# Frontend URL
FRONTEND_URL=http://localhost:3000
DOMAIN_URL=https://app.stylic.ai

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Google AI
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,gif,bmp,webp
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Credits
DEFAULT_SIGNUP_CREDITS=5

